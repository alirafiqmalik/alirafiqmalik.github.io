                    {
                      "type": "text",
                      "id": "ShlEK",
                      "name": "intro",
                      "fill": "$foreground",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When LLM controllers fail, they usually violate hidden constraints rather than obvious objectives. Reward optimization alone cannot capture these safety boundaries.",
                      "lineHeight": 1.55,
                      "fontFamily": "Manrope",
                      "fontSize": 20,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "N8YJE",
                      "name": "sec1Title",
                      "fill": "$foreground",
                      "content": "1. Encode specifications first",
                      "fontFamily": "Outfit",
                      "fontSize": 34,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "rPlYZ",
                      "name": "sec1Body",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Represent task and safety requirements explicitly as machine-checkable constraints before policy optimization starts.",
                      "lineHeight": 1.6,
                      "fontFamily": "Manrope",
                      "fontSize": 18,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "bz5CA",
                      "name": "sec2Title",
                      "fill": "$foreground",
                      "content": "2. Tune with DPO and RL",
                      "fontFamily": "Outfit",
                      "fontSize": 34,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "niXTc",
                      "name": "sec2Body",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Use preference and trajectory feedback to improve policy quality, while keeping objective shaping tied to verified constraints.",
                      "lineHeight": 1.6,
                      "fontFamily": "Manrope",
                      "fontSize": 18,
                      "fontWeight": "500"
                    },
                    {
                      "type": "frame",
                      "id": "1Qo5i",
                      "name": "quote",
                      "width": "fill_container",
                      "fill": "$card",
