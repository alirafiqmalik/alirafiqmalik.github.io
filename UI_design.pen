                          "name": "quoteTxt",
                          "fill": "$primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Model checking is not a post-processing step. It is part of training signal design.",
                          "lineHeight": 1.25,
                          "fontFamily": "Outfit",
                          "fontSize": 28,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "SOJM1",
                      "name": "sec3Title",
                      "fill": "$foreground",
                      "content": "3. Close the verification loop",
                      "fontFamily": "Outfit",
                      "fontSize": 34,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "xZPRg",
                      "name": "sec3Body",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Feed counterexamples from model checking back into training as hard negatives so policies learn to avoid unsafe state transitions.",
                      "lineHeight": 1.6,
                      "fontFamily": "Manrope",
                      "fontSize": 18,
                      "fontWeight": "500"
                    },
                    {
